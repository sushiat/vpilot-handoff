<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Issue #123 follow-up: Android's Local Network Permission restriction. Android 17
         (targetSdk 37, which this app already targets) blocks a TCP connect to any RFC1918
         address, and UDP discovery, unless this is granted, silently: a blocked TCP connect
         just hangs until connectTimeout (no exception distinguishing it from a genuine network
         failure), and blocked UDP sendto returns EPERM (this is almost certainly what issue #116
         actually hit, worked around there as a generic "discovery didn't work" fallback without
         anyone recognizing the real cause). Android 16 used NEARBY_WIFI_DEVICES as this same
         restriction's temporary permission before ACCESS_LOCAL_NETWORK became the permanent one
         on 17, so both are declared here to satisfy either OS version's gate. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Issue #73a: the opt in full-device debug snapshot screenshot. Android 14+ requires a
         foreground service to declare the mediaProjection type before MediaProjectionManager's
         getMediaProjection() can be called at all; HandoffConnectionService already runs in the
         foreground for its whole lifetime, so this is declared alongside its existing dataSync
         type rather than standing up a second service just for this. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the chat panel paint as a floating overlay while split-screened next to another
         EFB app, rather than being clipped to this app's own half of the screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Handoff"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HandoffConnectionService"
            android:foregroundServiceType="dataSync|mediaProjection"
            android:exported="false" />

    </application>

</manifest>
