{
	"folders": [
		{
			"name": "docs",
			"path": "."
		},
		{
			"name": "plugin",
			"path": "plugin"
		},
		{
			"name": "android",
			"path": "android"
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "plugin: build",
				"type": "shell",
				"command": "dotnet build Handoff.Plugin.csproj; dotnet build Handoff.RadioHost\\Handoff.RadioHost.csproj",
				"options": {
					"cwd": "${workspaceFolder:plugin}"
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": "$msCompile",
				"detail": "Builds both the plugin (AnyCPU, loads into vPilot's x86 process) and the Handoff.RadioHost SimConnect helper (x64, separate process -- see plugin/README.md)."
			},
			{
				"label": "plugin: deploy",
				"type": "shell",
				"command": "Copy-Item -Path 'bin\\Debug\\net48\\Handoff.Plugin.dll' -Destination \"$env:VPILOT_PLUGINS_DIR\" -Force -Verbose; if (Test-Path \"$env:VPILOT_PLUGINS_DIR\\RadioHost\" -PathType Leaf) { Remove-Item \"$env:VPILOT_PLUGINS_DIR\\RadioHost\" -Force }; New-Item -ItemType Directory -Force -Path \"$env:VPILOT_PLUGINS_DIR\\RadioHost\" | Out-Null; Copy-Item -Path 'Handoff.RadioHost\\bin\\Debug\\net48\\*' -Destination \"$env:VPILOT_PLUGINS_DIR\\RadioHost\" -Recurse -Force -Verbose",
				"options": {
					"cwd": "${workspaceFolder:plugin}"
				},
				"group": "build",
				"dependsOn": "plugin: build",
				"problemMatcher": [],
				"detail": "Copies the plugin DLL and the Handoff.RadioHost helper's output folder into the vPilot Plugins folder (as a RadioHost\\ subfolder, so vPilot's plugin scan doesn't trip over its dependency DLLs). Requires the VPILOT_PLUGINS_DIR env var; restart VS Code after setting it for the first time."
			},
			{
				"label": "android: assembleDebug",
				"type": "shell",
				"command": "./gradlew assembleDebug",
				"options": {
					"cwd": "${workspaceFolder:android}",
					"env": {
						"JAVA_HOME": "${env:USERPROFILE}\\scoop\\apps\\openjdk17\\current"
					}
				},
				"group": "build",
				"presentation": {
					"reveal": "always",
					"panel": "dedicated"
				},
				"problemMatcher": [],
				"detail": "Slow, especially on a cold Gradle daemon — runs in its own dedicated terminal panel so it doesn't block other tasks."
			}
		]
	}
}
