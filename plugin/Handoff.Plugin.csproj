<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Handoff.Plugin</RootNamespace>
    <AssemblyName>Handoff.Plugin</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- WebSocket server for the Android client. Raw TCP sockets, no http.sys involved,
         unlike HttpListener, so binding to a LAN-reachable address needs no admin rights or
         netsh URL-ACL setup. -->
    <PackageReference Include="Fleck" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared/ (with Handoff.RadioHost, the wire format and pure conversion/validation
         logic for the SimConnect IPC bridge, see plugin/README.md and RadioStateModel.cs) is
         under this project's own directory, so the default SDK-style glob already includes
         it; only Handoff.Plugin.Tests and Handoff.RadioHost (separate project directories)
         need excluding/explicit linking. -->
    <Compile Remove="Handoff.Plugin.Tests\**\*.cs" />
    <Compile Remove="Handoff.RadioHost\**\*.cs" />
    <Compile Remove="Handoff.ReplayTool\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RossCarlson.Vatsim.Vpilot.Plugins">
      <HintPath>lib\RossCarlson.Vatsim.Vpilot.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Used by SimBriefClient to fetch the flight plan from the SimBrief API. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
